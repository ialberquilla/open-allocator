# open-allocator configuration
#
#   cp .env.example .env && chmod 600 .env
#   uv run open-allocator wallet-status      # verify what you set below
#
# STEP 1-3 are the whole setup for the default (a local key signing over RPC).
# Every later step is gated: read its header, and skip the block entirely if
# the condition does not apply to you.


# ===========================================================================
# STEP 1 - 1Tx API                                       [always required]
# ===========================================================================
# Create the key at https://app.1tx.fi/settings
ONE_TX_API_URL=https://api.1tx.fi/api/v1
ONE_TX_API_KEY=replace-with-api-key


# ===========================================================================
# STEP 2 - how you sign                                  [always required]
# ===========================================================================
# Three independent choices. Leave all three alone and STEP 3 is all that is
# left. Change one and the step it points to says exactly what else to set.
#
#   SIGNER_ACCOUNT     eoa | safe                   what holds the funds  -> STEP 4
#   SIGNER_SUBMISSION  rpc | erc4337-paymaster      how the tx is sent    -> STEP 5
#   SIGNER_OWNER       local | remote               where the key lives   -> STEP 6

SIGNER_ACCOUNT=eoa
SIGNER_SUBMISSION=rpc
SIGNER_OWNER=local


# ===========================================================================
# STEP 3 - the signing key         [only if STEP 2 is untouched: eoa+rpc+local]
# ===========================================================================
# A raw key is needed only when no other axis supplies the signature: a Safe
# is signed by its owners in the Safe UI (STEP 4), a remote owner signs in the
# enclave (STEP 6), a 4337 submission signs through the paymaster (STEP 5).
ONE_TX_PRIVATE_KEY=0x...


# ===========================================================================
# STEP 4 - Safe                              [only if SIGNER_ACCOUNT=safe]
# ===========================================================================
# Check whatever you set here with:  uv run open-allocator safe-address

# --- pick ONE of (a) or (b) -----------------------------------------------
#
# (a) DERIVE it. The address is a pure function of these two values, so there
#     is nothing to create in the UI, it is the SAME address on every
#     supported chain, and the first operation on a chain deploys it there.
#     Owner ORDER is part of the function: reordering moves the Safe.
# SAFE_OWNERS=0xYourKey...,0xCoSigner...
# SAFE_THRESHOLD=2
#
# (b) ADOPT one that already exists. Nothing can deploy it for you, so it
#     must already be live on every chain you allocate to. Prefer (a) unless
#     you have a Safe you must keep.
# SAFE_ADDRESS=0x...

# --- only with SIGNER_SUBMISSION=rpc --------------------------------------
# A plan is not executed here, it is PROPOSED: each step is posted to the Safe
# Transaction Service, the off-chain queue where owners co-sign in the Safe UI
# and then execute. Signatures cost no gas and need not be collected at once.
# No chain to name. Each chain a plan touches is proposed to that chain's own
# service, looked up from the built-in registry. The account that proposes to
# those services, and its API key:
# SAFE_PROPOSER_ADDRESS=0x...
#
# The credential is the Safe developer-portal API key (https://app.safe.global
# -> API keys), NOT a private key: one key for every chain, and it only gets a
# proposal accepted by the service. It authorizes nothing on-chain, the owners'
# signatures do, so leaking it means unwanted entries in your Safe queue.
# SAFE_PROPOSER_CREDENTIAL=...

# --- rarely needed --------------------------------------------------------
# CREATE2 salt. Change it only to derive a second, different Safe from the
# same owners; it is not a transaction nonce.
# SAFE_SALT_NONCE=0


# ===========================================================================
# STEP 5 - gas in USDC          [only if SIGNER_SUBMISSION=erc4337-paymaster]
# ===========================================================================
# Pay gas in USDC out of your own funds instead of funding native gas on every
# chain. Self-custody is preserved: the paymaster fronts native gas to the
# EntryPoint and pulls USDC from your account. Which USDC, per chain, comes
# from the built-in registry - there is nothing to set for it here.
#
# PAYMASTER_PROVIDER=pimlico            # or: generic-http

# --- pimlico (default, ~40 chains) ----------------------------------------
# Get a key at https://dashboard.pimlico.io - the endpoint embeds the chain
# id, so the key is the entire config: per-chain URLs are derived from it.
# Prefer the keychain over this file:  keyring set open-allocator PIMLICO_API_KEY
# PIMLICO_API_KEY=pim_...
#
# With SIGNER_ACCOUNT=safe set this and leave PAYMASTER_ACCOUNT_ADDRESS unset:
# the Safe from STEP 4 is the account, whether derived (a) or adopted (b), so
# the two can never name different accounts.
# PAYMASTER_ACCOUNT_TYPE=safe

# --- generic-http (self-hosted or unlisted bundler) - all four required ----
# PAYMASTER_BUNDLER_URL=https://...
# PAYMASTER_URL=https://...
# PAYMASTER_ACCOUNT_ADDRESS=0x...
# EntryPoint v0.7. A Safe cannot use v0.8: Safe4337Module pins its EntryPoint
# in an immutable constructor arg, and its latest release is pinned to v0.7.
# PAYMASTER_ENTRY_POINT=0x0000000071727De22E5E9d8BAf0edAc6f37da032
# PAYMASTER_BUNDLER_CREDENTIAL=...
# PAYMASTER_CREDENTIAL=...

# --- optional -------------------------------------------------------------
# Which of the bundler's three fee quotes to bid. Raise it if ops sit
# unincluded: a pending op blocks the next one from this account.
# PAYMASTER_FEE_TIER=standard           # slow | standard | fast
# Narrow the chains the paymaster may pay gas on.
# PAYMASTER_SUPPORTED_CHAIN_IDS=8453,42161,143


# ===========================================================================
# STEP 6 - remote signer                       [only if SIGNER_OWNER=remote]
# ===========================================================================
# The owner key lives in an enclave. All four are required together.
# REMOTE_SIGNER_PROVIDER=generic-http
# REMOTE_SIGNER_URL=https://...
# REMOTE_SIGNER_CREDENTIAL=...
# REMOTE_SIGNER_KEY_ID=...
# Optional: the address the enclave signs for, if you want it checked.
# REMOTE_SIGNER_ADDRESS=0x...


# ===========================================================================
# STEP 7 - per-chain overrides                                   [optional]
# ===========================================================================
# This is a multichain allocator, so there is no single RPC setting - one URL
# would be wrong on every other chain. Every supported chain ships a public
# default; override one chain at a time with the suffixed form. These are read
# from the process environment only, not from this file: export them in the
# shell that runs the CLI.
# RPC_URL_8453=https://...
# RPC_URL_42161=https://...
#
# Same shape for the paymaster's gas token, when a chain needs a bridged
# variant or has no registry row (Blast, 81457, has no canonical USDC).
# PAYMASTER_USDC_ADDRESS_81457=0x...


# ===========================================================================
# STEP 8 - tuning, secrets, state              [optional, defaults shown]
# ===========================================================================
# ONE_TX_SLIPPAGE_BPS=50
# ONE_TX_FAST_TRANSFER=false

# 1Tx builder API during the calldata migration: `legacy` or `calldata`.
# Unset means `legacy`, which is unchanged. `calldata` plans and executes
# deposits, withdrawals, and same-chain rebalances through the Safe, each chain
# as one operation. A deposit whose chain lacks USDC is bridged over CCTP from a
# funded chain (ONE_TX_FAST_TRANSFER picks fast or standard) and settled by
# rerunning `execute --confirm`; that needs SIGNER_SUBMISSION=erc4337-paymaster
# with PAYMASTER_PROVIDER=pimlico. A rebalance funded by another chain is
# refused. It rejects referral settings and fails on instruments 1Tx does not
# serve through the calldata API. It reads balances and estimates gas over RPC,
# so set a private RPC_URL_<chain> for each chain (the public defaults
# rate-limit).
# ONE_TX_TRANSACTION_API=legacy
# Least lifetime a calldata swap quote must have left when planned and again
# just before signing; 1Tx quotes live 60s.
# ONE_TX_MIN_CALLDATA_TTL_SECONDS=20
# Circle's attestation service for bridged calldata deposits. The timeout and
# retries bound each check; an unready attestation returns in_progress.
# CIRCLE_IRIS_API_URL=https://iris-api.circle.com
# CIRCLE_HTTP_TIMEOUT_SECONDS=10
# CIRCLE_HTTP_MAX_RETRIES=2

# Referral. Set both or neither; max fee is 500 bps.
# ONE_TX_REFERRAL_FEE_BPS=25
# ONE_TX_REFERRAL_WALLET=0x...

# Secrets are looked up in the OS keychain BEFORE this file, so any value
# above can live there instead. `none` disables it; `gcp` also needs
# OPEN_ALLOCATOR_GCP_SECRET_PROJECT.
# OPEN_ALLOCATOR_SECRET_BACKEND=keyring

# Which .env to read. Must be set in the shell, not in this file. Point it
# outside the working tree to keep the plaintext file out of the repo an
# agent can read.
# OPEN_ALLOCATOR_ENV_FILE=/home/you/.config/open-allocator/.env

# Where run state lands.
# OPEN_ALLOCATOR_IDEMPOTENCY_STORE=.open_allocator/execution-idempotency.json
# OPEN_ALLOCATOR_CHECKPOINT_DIR=.open_allocator/checkpoints
# OPEN_ALLOCATOR_ALLOCATION_LOG=.open_allocator/allocation-log.jsonl
