{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-allocator.local/schemas/tx-plan.schema.json",
  "title": "TxPlan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TxStep"
      }
    },
    "summary": {
      "type": "string"
    },
    "bundles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TxBundle"
      }
    }
  },
  "required": ["steps", "summary"],
  "$defs": {
    "TxStep": {
      "title": "TxStep",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "to": {
          "type": "string"
        },
        "data": {
          "type": "string"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "chain_id": {
          "type": "integer"
        },
        "kind": {
          "enum": [
            "approve",
            "swap",
            "deposit",
            "withdraw",
            "bridge_burn",
            "cctp_receive",
            "fee",
            "buy",
            "sell"
          ]
        }
      },
      "required": ["to", "data", "value", "chain_id", "kind"]
    },
    "RawUint": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "BundleToken": {
      "title": "BundleToken",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string"
        },
        "symbol": {
          "type": ["string", "null"]
        },
        "decimals": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["address", "decimals"]
    },
    "TxBundle": {
      "title": "TxBundle",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundle_id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "leg_index": {
          "type": "integer",
          "minimum": 0
        },
        "instrument_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": ["deposit", "withdraw"]
        },
        "account": {
          "type": "string"
        },
        "chain_id": {
          "type": "integer",
          "minimum": 1
        },
        "step_indexes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "source": {
          "enum": ["1tx-calldata"]
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "string",
          "pattern": "^(?:max|[1-9][0-9]*)$"
        },
        "token_in": {
          "$ref": "#/$defs/BundleToken"
        },
        "token_out": {
          "$ref": "#/$defs/BundleToken"
        },
        "quote_block": {
          "type": "integer",
          "minimum": 0
        },
        "expires_at": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "requires": {
          "type": "array",
          "items": {
            "title": "BundleRequirement",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "token": {
                "type": "string"
              },
              "amount": {
                "$ref": "#/$defs/RawUint"
              }
            },
            "required": ["token", "amount"]
          }
        },
        "leftovers": {
          "type": "array",
          "items": {
            "title": "BundleLeftover",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "token": {
                "type": "string"
              },
              "max_amount": {
                "$ref": "#/$defs/RawUint"
              }
            },
            "required": ["token", "max_amount"]
          }
        },
        "expected_out": {
          "anyOf": [{ "$ref": "#/$defs/RawUint" }, { "type": "null" }]
        },
        "min_out": {
          "anyOf": [{ "$ref": "#/$defs/RawUint" }, { "type": "null" }]
        },
        "protocol_gas": {
          "$ref": "#/$defs/RawUint"
        },
        "simulation_scope": {
          "enum": ["protocol_bundle"]
        },
        "simulation_engine": {
          "enum": ["wallet_neutral_atomic"]
        }
      },
      "required": [
        "bundle_id",
        "digest",
        "leg_index",
        "instrument_id",
        "action",
        "account",
        "chain_id",
        "step_indexes",
        "endpoint",
        "amount",
        "token_in",
        "token_out",
        "quote_block",
        "protocol_gas"
      ]
    }
  }
}
