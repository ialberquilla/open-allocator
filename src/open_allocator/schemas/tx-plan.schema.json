{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-allocator.local/schemas/tx-plan.schema.json",
  "title": "TxPlan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TxStep"
      }
    },
    "summary": {
      "type": "string"
    },
    "bundles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TxBundle"
      }
    }
  },
  "required": ["steps", "summary"],
  "$defs": {
    "TxStep": {
      "title": "TxStep",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "to": {
          "type": "string"
        },
        "data": {
          "type": "string"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "chain_id": {
          "type": "integer"
        },
        "kind": {
          "enum": [
            "approve",
            "swap",
            "deposit",
            "withdraw",
            "bridge_burn",
            "cctp_receive",
            "fee",
            "borrow",
            "repay",
            "set_account_config",
            "buy",
            "sell"
          ]
        }
      },
      "required": ["to", "data", "value", "chain_id", "kind"]
    },
    "RawUint": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "BundleBridge": {
      "title": "BundleBridge",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "to_chain_id": {
          "type": "integer",
          "minimum": 1
        },
        "source_domain": {
          "type": "integer",
          "minimum": 0
        },
        "destination_domain": {
          "type": "integer",
          "minimum": 0
        },
        "max_fee": {
          "$ref": "#/$defs/RawUint"
        },
        "min_finality_threshold": {
          "enum": [1000, 2000]
        },
        "fast": {
          "type": "boolean"
        }
      },
      "required": [
        "to_chain_id",
        "source_domain",
        "destination_domain",
        "max_fee",
        "min_finality_threshold",
        "fast"
      ]
    },
    "BundleToken": {
      "title": "BundleToken",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string"
        },
        "symbol": {
          "type": ["string", "null"]
        },
        "decimals": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["address", "decimals"]
    },
    "BundleLoop": {
      "title": "BundleLoop",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loop_id": { "type": "string", "minLength": 1 },
        "recipe": { "type": "string", "minLength": 1 },
        "pool": { "type": "string" },
        "collateral_instrument_id": { "type": "string", "minLength": 1 },
        "debt_instrument_id": { "type": "string", "minLength": 1 },
        "debt_token": {
          "anyOf": [{ "$ref": "#/$defs/BundleToken" }, { "type": "null" }]
        },
        "same_asset": { "type": "boolean" },
        "requested_leverage": {
          "type": ["number", "null"],
          "exclusiveMinimum": 1
        },
        "ltv": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "liquidation_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "params_basis": { "type": "string" },
        "oracle": { "type": "string" },
        "requires_account_config": { "type": "boolean" },
        "account_config_current": { "type": "integer", "minimum": 0 },
        "account_config_target": { "type": "integer", "minimum": 0 },
        "simulated_collateral": { "$ref": "#/$defs/RawUint" },
        "simulated_debt": { "$ref": "#/$defs/RawUint" },
        "simulated_leverage": { "type": ["number", "null"] },
        "simulated_health_factor": { "type": ["number", "null"] },
        "simulated_depeg_buffer_bps": { "type": ["integer", "null"] },
        "modelled_health_factor": { "type": ["number", "null"] },
        "modelled_depeg_buffer_bps": { "type": ["integer", "null"] },
        "turns": { "type": "integer", "minimum": 0 }
      },
      "required": [
        "loop_id",
        "recipe",
        "pool",
        "collateral_instrument_id",
        "debt_instrument_id",
        "same_asset",
        "ltv",
        "liquidation_threshold",
        "params_basis",
        "oracle",
        "requires_account_config",
        "account_config_current",
        "account_config_target",
        "simulated_collateral",
        "simulated_debt",
        "turns"
      ]
    },
    "TxBundle": {
      "title": "TxBundle",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundle_id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "leg_index": {
          "type": "integer",
          "minimum": 0
        },
        "instrument_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "deposit",
            "withdraw",
            "bridge",
            "cctp_receive",
            "loop_open",
            "loop_adjust",
            "loop_close"
          ]
        },
        "account": {
          "type": "string"
        },
        "chain_id": {
          "type": "integer",
          "minimum": 1
        },
        "step_indexes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "source": {
          "enum": ["1tx-calldata", "open-allocator"]
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "string",
          "pattern": "^(?:max|[1-9][0-9]*)$"
        },
        "token_in": {
          "$ref": "#/$defs/BundleToken"
        },
        "token_out": {
          "$ref": "#/$defs/BundleToken"
        },
        "quote_block": {
          "type": "integer",
          "minimum": 0
        },
        "expires_at": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "requires": {
          "type": "array",
          "items": {
            "title": "BundleRequirement",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "token": {
                "type": "string"
              },
              "amount": {
                "$ref": "#/$defs/RawUint"
              }
            },
            "required": ["token", "amount"]
          }
        },
        "leftovers": {
          "type": "array",
          "items": {
            "title": "BundleLeftover",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "token": {
                "type": "string"
              },
              "max_amount": {
                "$ref": "#/$defs/RawUint"
              }
            },
            "required": ["token", "max_amount"]
          }
        },
        "expected_out": {
          "anyOf": [{ "$ref": "#/$defs/RawUint" }, { "type": "null" }]
        },
        "min_out": {
          "anyOf": [{ "$ref": "#/$defs/RawUint" }, { "type": "null" }]
        },
        "protocol_gas": {
          "anyOf": [{ "$ref": "#/$defs/RawUint" }, { "type": "null" }]
        },
        "simulated_out": {
          "anyOf": [{ "$ref": "#/$defs/RawUint" }, { "type": "null" }]
        },
        "simulation_scope": {
          "enum": ["protocol_bundle", null]
        },
        "simulation_engine": {
          "enum": ["wallet_neutral_atomic", null]
        },
        "bridge": {
          "anyOf": [{ "$ref": "#/$defs/BundleBridge" }, { "type": "null" }]
        },
        "loop": {
          "anyOf": [{ "$ref": "#/$defs/BundleLoop" }, { "type": "null" }]
        }
      },
      "required": [
        "bundle_id",
        "digest",
        "leg_index",
        "instrument_id",
        "action",
        "account",
        "chain_id",
        "step_indexes",
        "endpoint",
        "amount",
        "token_in",
        "token_out",
        "quote_block",
        "protocol_gas"
      ]
    }
  }
}
