{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-allocator.local/schemas/policy.schema.json",
  "title": "Policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer"
    },
    "wallet": {
      "$ref": "#/$defs/PolicyWallet"
    },
    "allowed": {
      "$ref": "#/$defs/PolicyAllowed"
    },
    "caps": {
      "$ref": "#/$defs/PolicyCaps"
    },
    "gates": {
      "$ref": "#/$defs/PolicyGates"
    }
  },
  "required": ["wallet", "allowed", "caps", "gates"],
  "$defs": {
    "PolicyWallet": {
      "title": "PolicyWallet",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string"
        },
        "signer": {
          "enum": ["local-eoa", "remote", "safe", "erc4337-paymaster"]
        }
      },
      "required": ["mode", "signer"]
    },
    "PolicyAllowed": {
      "title": "PolicyAllowed",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocols": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "chains": {
          "type": ["array", "null"],
          "items": {
            "type": "integer"
          }
        },
        "asset_categories": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "stablecoin_only": {
          "type": ["boolean", "null"]
        },
        "assets": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "curators": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "PolicyCaps": {
      "title": "PolicyCaps",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_weight_per_instrument": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_weight_per_protocol": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_weight_per_curator": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_weight_per_chain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_weight_per_sector": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "min_effective_positions": {
          "description": "Floor on the measured effective number of independent positions, computed from instrument APY history. Unlike the max_weight_per_* caps this is a lower bound over the whole allocation and cannot be satisfied by spreading capital across labels that move together. Null or absent = not enforced.",
          "type": ["number", "null"],
          "minimum": 0
        },
        "min_instrument_tvl_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_reward_dependence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_gross_leverage": {
          "description": "Largest leverage any one levered leg may be held at. A leg with no chosen leverage is charged at its row's declared max_leverage. Null or absent = not enforced.",
          "type": ["number", "null"],
          "minimum": 1
        },
        "max_book_gross_exposure": {
          "description": "Ceiling on sum(weight x leverage) over the book; unlevered legs count at 1, so 1.0 admits no leverage. Null or absent = not enforced.",
          "type": ["number", "null"],
          "minimum": 1
        },
        "max_weight_levered": {
          "description": "Ceiling on the summed equity weight of levered legs; 0 admits none. Null or absent = not enforced. A derived policy that admits levered weight must carry a rationale entry for it.",
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "min_health_factor": {
          "description": "Floor on each levered leg's health factor at its leverage. Must exceed 1: an opened position's health factor is never below 1, so a floor at or under it binds nothing. Null or absent = not enforced.",
          "type": ["number", "null"],
          "exclusiveMinimum": 1
        },
        "min_depeg_buffer_bps": {
          "description": "Floor on the adverse debt/collateral move a cross-asset levered leg survives, (HF - 1) x 10000. Same-asset legs are exempt. Null or absent = not enforced.",
          "type": ["number", "null"],
          "minimum": 0
        },
        "min_reward_liquidity_usd": {
          "description": "Floor on a levered row's reward-token 24h volume; replaces max_reward_dependence for levered rows. Unmeasured volume fails it. Null or absent = not enforced.",
          "type": ["number", "null"],
          "minimum": 0
        }
      },
      "required": [
        "max_weight_per_instrument",
        "max_weight_per_protocol",
        "max_weight_per_curator",
        "max_weight_per_chain",
        "min_instrument_tvl_usd",
        "max_reward_dependence"
      ]
    },
    "PolicyGates": {
      "title": "PolicyGates",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "new_instrument_needs_approval": {
          "type": "boolean"
        },
        "autonomous_rebalance": {
          "type": "boolean"
        },
        "max_deploy_per_cycle_usd": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "new_instrument_needs_approval",
        "autonomous_rebalance",
        "max_deploy_per_cycle_usd"
      ]
    }
  }
}
